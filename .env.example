# Copy to .env and fill in. NEVER commit .env
GEMINI_API_KEY=
GROQ_API_KEY=
GITHUB_TOKEN=            # optional but strongly recommended (5000 req/h vs 60)
USER_AGENT=GraphOneResearchBot/1.0 (+contact: you@example.com)
GLOBAL_CONCURRENCY=50
PER_HOST_CONCURRENCY=5

# Model names (verified against the keys' model lists on 2026-11-22; override if yours differ)
GEMINI_MODEL_MAIN=gemini-2.5-flash
GEMINI_MODEL_LITE=gemini-2.5-flash-lite
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b
